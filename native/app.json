{
  "expo": {
    "name": "Sage",
    "owner": "jorgeasenrivs-team",
    "slug": "sage",
    "scheme": "sage",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#15211B",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#55795F"
    },
    "ios": {
      "bundleIdentifier": "com.sageonline",
      "supportsTablet": false,
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification",
          "location"
        ],
        "NSLocationWhenInUseUsageDescription": "Sage checks you are at the store when you get on the floor.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true,
        "WKAppBoundDomains": [
          "sageonline.io"
        ],
        "NSSupportsLiveActivitiesFrequentUpdates": true,
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Sage notices when you leave the lot so it can ask whether you are done for the day.",
        "NSLocationAlwaysUsageDescription": "Sage notices when you leave the lot so it can ask whether you are done for the day."
      }
    },
    "android": {
      "package": "com.sageonline",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2E3A32"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "POST_PROMOTED_NOTIFICATIONS"
      ],
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-splash-screen",
      [
        "expo-notifications",
        {
          "color": "#15211B",
          "defaultChannel": "floor"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sage checks you are at the store when you get on the floor.",
          "locationAlwaysAndWhenInUsePermission": "Sage notices when you leave the lot so it can ask whether you are done for the day.",
          "isIosBackgroundLocationEnabled": true
        }
      ],
      "./plugins/withSwiftTypeCheckWarning.js",
      "@bacons/apple-targets",
      "./plugins/withQueueIntent.js"
    ],
    "extra": {
      "siteUrl": "https://www.sageonline.io",
      "eas": {
        "projectId": "6b755c67-3bd6-4f28-ae12-6d9759c0f667"
      }
    }
  }
}
